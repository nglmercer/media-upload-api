{
  "name": "widget-overlay-api",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile=dist/index",
    "build:app": "bun build --compile src/index.ts --outfile=dist/media-upload-api",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile=dist/media-upload-api-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/index.ts --outfile=dist/media-upload-api-linux-arm64",
    "build:windows": "bun build --compile --target=bun-windows-x64 src/index.ts --outfile=dist/media-upload-api-windows-x64",
    "build:macos": "bun build --compile --target=bun-darwin-x64 src/index.ts --outfile=dist/media-upload-api-darwin-x64",
    "build:macos-arm64": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile=dist/media-upload-api-darwin-arm64",
    "build:prod": "bun build --compile --minify --sourcemap --bytecode src/index.ts --outfile=dist/media-upload-api",
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test tests/store.test.ts tests/config.test.ts",
    "test:integration": "bun test tests/media.test.ts tests/integration.test.ts"
  },
  "dependencies": {
    "file-type": "^21.1.1",
    "hono": "^4.9.5",
    "json-obj-manager": "^3.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
