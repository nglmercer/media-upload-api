{
  "name": "widget-overlay-api",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "alerts:demo": "bun --watch ./alerts/demo.html",
    "alerts:preview": "bun --watch ./alerts/preview.html",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test tests/store.test.ts tests/config.test.ts",
    "test:integration": "bun test tests/media.test.ts tests/integration.test.ts"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "animejs": "^4.3.6",
    "drizzle-orm": "^0.45.2",
    "file-type": "^21.1.1",
    "json-obj-manager": "^3.6.0",
    "lit": "^3.3.2",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  }
}
